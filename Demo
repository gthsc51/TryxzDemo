SubTeleport:AddButton({
    Name = "Teleport Behind Target",
    Icon = "rbxassetid://10734950309",
    Sound = "TeleportWhoosh",
    Cooldown = 2,
    Callback = function()
        if State.TargetFilter == "" then
            TryxzLib:Notify({Title = "Empty Filter", Text = "Enter a player name first.", Duration = 2.5, Sound = "Error"})
            return
        end
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and string.find(string.lower(plr.Name), string.lower(State.TargetFilter), 1, true) then
                if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character then
                    LocalPlayer.Character:PivotTo(plr.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3))
                    TryxzLib:Notify({Title = "Teleported", Text = "Moved near " .. plr.Name, Duration = 2.5})
                    return
                end
            end
        end
        TryxzLib:Notify({Title = "No Match", Text = "Player not found in server.", Duration = 2.5, Sound = "Error"})
    end
})

